# Copy to .env.daytona (gitignored), chmod 600, then fill in the values.
# Host-only credential. Never put this key in frontend variables or a sandbox.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Full 40-character commit SHAs published in this public repository.
# The base, breaking proposal and compatible proposal must be distinct source revisions.
# See docs/DAYTONA.md for the sample source contract.
GECCO_CLOUD_BASE_REF=7f805118b53ee45f52b35341741ca6d9238558c1
GECCO_CLOUD_BREAKING_REF=1f268d12cb3ab6da1621f27430e11541ad46253a
GECCO_CLOUD_COMPATIBLE_REF=b8e434f81caf6fe871d6d775c56717d53e3535ef

# Public demo PR resolved through the host GitHub CLI. Repairs append a commit to this PR.
GECCO_DEMO_PR_URL=https://github.com/kllymx/gecco-rehearsals/pull/1

# The coordinator always listens on loopback.
GECCO_PORT=5181
# Set only when using an explicit Tailscale Serve HTTPS origin.
# GECCO_PUBLIC_ORIGIN=https://your-device.your-tailnet.ts.net:10000

# Optional live analysis uses your existing Codex CLI authentication.
# GECCO_AI_MODEL=gpt-6-astra
# GECCO_CODEX_BIN=/absolute/path/to/codex

# Optional explicit Responses endpoint for repair and analysis. Both fields are required.
# The key is host-only and passed to the runner through its environment, never CLI arguments.
# OPENAI_BASE_URL=https://your-authorized-endpoint.example/v1
# OPENAI_API_KEY=your-private-client-key
# Or read only those two settings from an explicitly selected private file on each call:
# GECCO_AI_ENV_FILE=/absolute/path/to/private-ai.env
# Custom configuration disables ChatGPT-auth fallback and automatic request/stream retries.

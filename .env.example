# Copy to .env.daytona (gitignored), chmod 600, then fill in the values.
# Host-only credential. Never put this key in frontend variables or a sandbox.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Full 40-character commit SHAs published in this public repository.
# The base, breaking proposal and compatible proposal must be distinct source revisions.
# See docs/DAYTONA.md for the sample source contract.
GECCO_CLOUD_BASE_REF=d0695e004b6b993f017649e7d91e877b581d00b8
GECCO_CLOUD_BREAKING_REF=c784b9a274fad83eeea7ed06823e90989b527094
GECCO_CLOUD_COMPATIBLE_REF=46e5ea6adcd34dc1abfa4f988c268bd64ea15e1c

# The coordinator always listens on loopback.
GECCO_PORT=5181
# Set only when using an explicit Tailscale Serve HTTPS origin.
# GECCO_PUBLIC_ORIGIN=https://your-device.your-tailnet.ts.net:10000

# Optional live analysis uses your existing Codex CLI authentication.
# GECCO_AI_MODEL=gpt-6-astra
# GECCO_CODEX_BIN=/absolute/path/to/codex
